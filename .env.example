# Active Client Demo Config (folder name inside clients/)
CLIENT=gayatree-stay

# Environment
NODE_ENV=development
PORT=5000
WEB_URL=http://localhost:3000
API_URL=http://localhost:5000/api/v1

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# Google Maps Platform
GOOGLE_MAPS_KEY=AIzaSyYourGoogleMapsApiKeyHere

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_demo_db?schema=public"

# Owner Dashboard Access PIN
OWNER_PIN="1234"

# Notifications (Optional Email/WhatsApp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Demo Stay Reservations <demo@hotel-demo-template.com>"

# Booking Engine Settings
HOLD_EXPIRY_MINUTES=15
