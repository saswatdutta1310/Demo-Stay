datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BookingStatus {
  PENDING
  HOLD
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  SUCCESS
  FAILED
  REFUNDED
}

model Room {
  id              String        @id
  name            String
  slug            String        @unique
  price           Float
  capacity        Int           @default(2)
  unitsAvailable  Int           @default(1)
  description     String
  amenities       String[]
  images          String[]
  bedType         String        @default("Double Bed")
  createdAt       DateTime      @default(now())

  bookings        Booking[]
  blockedDates    BlockedDate[]
  priceRules      PriceRule[]
}

model Guest {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String
  idType      String?
  idNumber    String?
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Booking {
  id              String        @id @default(cuid())
  code            String        @unique
  roomId          String
  room            Room          @relation(fields: [roomId], references: [id])
  guestId         String
  guest           Guest         @relation(fields: [guestId], references: [id])
  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  guestsCount     Int           @default(1)
  baseAmount      Float
  taxAmount       Float
  totalAmount     Float
  status          BookingStatus @default(HOLD)
  holdExpiresAt   DateTime?
  specialRequests String?

  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([roomId, checkIn, checkOut])
  @@index([code])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model PriceRule {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  price     Float
  note      String?
  createdAt DateTime @default(now())
}

model Feedback {
  id           String   @id @default(cuid())
  name         String
  phoneOrEmail String
  hotelName    String
  rating       Int      @default(5)
  message      String
  createdAt    DateTime @default(now())
}
