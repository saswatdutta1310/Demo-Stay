{
  "name": "hotel-demo-template",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-client white-label hotel & guest house direct booking demo platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@hotel-demo/web",
    "dev:api": "npm run dev --workspace=@hotel-demo/api",
    "dev": "concurrently -k -p \"[{name}]\" -n \"web,api\" -c \"cyan.bold,magenta.bold\" \"npm run dev:web\" \"npm run dev:api\"",
    "build:shared": "npm run build --workspace=@hotel-demo/shared",
    "build:web": "npm run build --workspace=@hotel-demo/web",
    "build:api": "npm run prisma:generate && npm run build --workspace=@hotel-demo/api",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "prisma:generate": "npm run prisma:generate --workspace=@hotel-demo/api",
    "db:migrate": "npm run db:migrate --workspace=@hotel-demo/api",
    "db:push": "npm run db:push --workspace=@hotel-demo/api",
    "db:seed": "npm run db:seed --workspace=@hotel-demo/api",
    "db:reset": "npm run db:reset --workspace=@hotel-demo/api",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test:shared": "npm run test --workspace=@hotel-demo/shared",
    "test:api": "npm run test --workspace=@hotel-demo/api",
    "test": "npm run test:shared && npm run test:api",
    "lint": "eslint .",
    "client:new": "ts-node scripts/new-client.ts",
    "client:validate": "ts-node scripts/validate-client.ts",
    "demo:seed": "ts-node scripts/seed-demo.ts",
    "demo:reset": "ts-node scripts/reset-demo.ts",
    "demo:deploy": "ts-node scripts/deploy-demo.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "concurrently": "^10.0.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
